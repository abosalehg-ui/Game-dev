{
  "name": "room-to-top",
  "version": "1.9.0",
  "description": "من الغرفة للقمة — محاكي تطوير ألعاب ثلاثي الأبعاد في ملف HTML واحد",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node tools/check-syntax.mjs",
    "test": "node tests/smoke.mjs && node tests/topic-detect.mjs && node tests/topic-flow.mjs && node tests/save-integrity.mjs && node tests/pathfinding.mjs && node tests/playthrough.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:topic": "node tests/topic-detect.mjs && node tests/topic-flow.mjs",
    "test:save": "node tests/save-integrity.mjs",
    "balance": "node tools/balance-sim.mjs",
    "icons": "python3 scripts/make_icons.py",
    "test:play": "node tests/playthrough.mjs",
    "shots": "node tools/shot-stages.mjs",
    "shots:readme": "node tools/shot-readme.mjs",
    "three": "node tools/build-three.mjs",
    "test:path": "node tests/pathfinding.mjs"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  }
}
